{
  "name": "pokevue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "convert-images": "sharp -i src/assets/images/pokemons/*.png -o src/assets/images/pokemons/webp --format=webp",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "axios": "^1.19.0",
    "pinia": "^4.0.3",
    "sass": "^1.102.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.10"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  }
}
